get_filename_component(SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
get_property(_sdk_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
if(_sdk_languages)
    message(FATAL_ERROR "find_package(RtosSdk) must precede the application's first project()")
endif()
if(NOT DEFINED t)
    set(t armgcc9)
endif()
include("${SDK_ROOT}/tools/cmake/toolchain/${t}.cmake")
if(NOT DEFINED APPLICATION)
    set(APPLICATION "${CMAKE_SOURCE_DIR}")
endif()
add_subdirectory("${SDK_ROOT}" "${CMAKE_BINARY_DIR}/sdk")
set(RtosSdk_FOUND TRUE)
