menu "Device Drivers"

config STM32_DIRECT_REGISTER_DRIVERS
	bool "Experimental STM32 direct-register peripheral backends"
	depends on SOC_FAMILY_STM32
	default n
	help
	  Enable the STM32 UART, SPI, PWM, I2C and Flash direct-register
	  backends for board bring-up only. These backends still require a
	  product clock/reset owner and hardware validation. Product builds
	  should leave this disabled until those contracts are supplied.

