menuconfig GIMBAL
    bool "Three-axis gimbal control"
    help
      Enable the product-independent gimbal estimation, planning, control,
      continuous Hall and voltage-FOC components.

if GIMBAL

choice GIMBAL_MOTOR_CONTROL_MODE
    prompt "Gimbal motor control mode"
    default GIMBAL_MOTOR_VOLTAGE_FOC

config GIMBAL_MOTOR_VOLTAGE_FOC
    bool "Hall-sensored voltage FOC"
    help
      Baseline mode without phase-current sampling. This is not a torque loop.

config GIMBAL_MOTOR_CURRENT_FOC
    bool "Current FOC"
    depends on ADC
    help
      Optional mode for hardware with synchronized phase-current sampling.

endchoice

config GIMBAL_CONTROL_HZ
    int "Attitude and rate control frequency"
    range 500 2000
    default 1000

config GIMBAL_SENSOR_HZ
    int "Synchronous sensor trigger frequency"
    range 8000 32000
    default 16000
    help
      Hardware timer rate used to launch asynchronous sensor DMA. It must be
      an integer multiple of GIMBAL_CONTROL_HZ.

config GIMBAL_PLANNER_HZ
    int "Motion planner frequency"
    range 100 500
    default 200

config GIMBAL_THERMAL_HZ
    int "IMU thermal controller frequency"
    range 10 100
    default 20

config GIMBAL_SUPERVISOR_HZ
    int "Safety supervisor frequency"
    range 10 200
    default 100

config GIMBAL_VBUS_SENSE
    bool "Bus-voltage sampling is installed"
    depends on ADC
    default n

config GIMBAL_PHASE_CURRENT_SENSE
    bool "Phase-current sampling is installed"
    depends on ADC
    default y if GIMBAL_MOTOR_CURRENT_FOC
    default n

config GIMBAL_DRIVER_TEMP_SENSE
    bool "Motor-driver temperature sensing is installed"
    depends on ADC
    default n

config GIMBAL_MOS_TEMP_SENSE
    bool "MOS temperature sensing is installed"
    depends on ADC
    default n

endif
