menuconfig BLE_GR5525
    bool "Goodix GR5525 BLE stack"
    default n
    depends on SOC_SERIES_GR5525X
    help
      Enable Goodix GR5525 BLE protocol stack.

if BLE_GR5525

config BLE_HID
    bool "BLE HID Service (HIDS)"
    default y
    help
      Enable HIDS for BLE HID devices (keyboard/mouse).

config BLE_UART_SERVICE
    bool "BLE UART Service (GUS)"
    default y
    help
      Enable GUS for BLE UART transparent data.

config BLE_BATTERY_SERVICE
    bool "BLE Battery Service (BAS)"
    default y
    help
      Enable BAS for battery level reporting.

config BLE_DEVICE_INFO
    bool "BLE Device Information Service (DIS)"
    default y
    help
      Enable DIS for device information.

config BLE_TASK_STACK_SIZE
    int "BLE owner task stack size (bytes)"
    default 2048
    range 768 8192
    help
      Caller-owned stack for the application task that serializes outbound
      profile operations and handles deferred BLE application events. The
      Goodix controller/host stack itself uses SDK-defined static heaps and an
      interrupt-driven scheduler.

config BLE_EVENT_QUEUE_DEPTH
    int "BLE deferred application event depth"
    default 8
    range 4 32
    help
      Usable entries in the static single-producer/single-consumer ring that
      moves connection state and GUS RX data out of the BLE software ISR.

config BLE_COMMAND_QUEUE_DEPTH
    int "BLE outbound command queue depth"
    depends on BLE_HID || BLE_UART_SERVICE
    default 8
    range 2 32
    help
      Number of fixed-size HID/UART commands accepted before producers receive
      backpressure. Queue data and control storage are statically allocated.

config BLE_COMMAND_TIMEOUT_MS
    int "BLE command completion timeout (milliseconds)"
    depends on BLE_HID || BLE_UART_SERVICE
    default 250
    range 20 2000
    help
      Maximum time the BLE command owner retries a temporarily busy profile
      operation before dropping it and recording a timeout.

# ── BLE 协议栈编译时参数 ──

config BLE_MAX_CONNECTIONS
    int "Max BLE connections"
    default 1
    range 1 10
    help
      Maximum number of simultaneous BLE connections (CFG_MAX_CONNECTIONS).

config BLE_MAX_ADVS
    int "Max BLE advertisers"
    default 1
    range 1 5
    help
      Maximum number of BLE advertising sets (CFG_MAX_ADVS).

config BLE_MAX_SCAN
    int "Max BLE scan instances"
    default 0
    range 0 1
    help
      Maximum number of BLE scan instances. 0 = scanning disabled.

config BLE_CONNLESS_AOA_AOD
    bool "Connectionless AoA/AoD support"
    default n
    help
      Enable connectionless Angle of Arrival/Departure support.

config BLE_MAX_BOND_DEVS
    int "Max bonded devices"
    default 1
    range 1 16
    help
      Maximum number of bonded BLE devices (CFG_MAX_BOND_DEVS).

config BLE_MAX_PRFS
    int "Max BLE profiles"
    default 8
    range 1 64
    help
      Maximum number of BLE profiles (CFG_MAX_PRFS).

config BLE_CONTROLLER_ONLY
    bool "BLE controller only (no host)"
    default n
    help
      Build BLE controller only, without the host stack.

endif # BLE_GR5525
