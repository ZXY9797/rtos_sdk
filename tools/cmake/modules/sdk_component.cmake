include_guard(GLOBAL)

function(sdk_attach_target name)
    get_target_property(_type ${name} TYPE)
    get_target_property(_imported ${name} IMPORTED)
    if(_imported OR _type STREQUAL "INTERFACE_LIBRARY")
        return()
    endif()
    if(TARGET sdk_build_config)
        target_link_libraries(${name} PRIVATE sdk_build_config)
        if(CONFIG_SDK_OPTIMIZE_FOR_SIZE AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
            set_property(TARGET ${name} PROPERTY INTERPROCEDURAL_OPTIMIZATION TRUE)
        endif()
    endif()
endfunction()

function(sdk_add_library name)
    add_library(${name} ${ARGN})
    sdk_attach_target(${name})
endfunction()

# Also usable from a host project: no firmware policy is added unless the
# firmware build explicitly created sdk_build_config.
function(sdk_add_component name)
    cmake_parse_arguments(COMP "INTERFACE" "" "SOURCES;INCLUDE_DIRS;PRIV_INCLUDE_DIRS;REQUIRES;PRIV_REQUIRES" ${ARGN})
    if(COMP_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "Unknown arguments for component ${name}: ${COMP_UNPARSED_ARGUMENTS}")
    endif()
    if(COMP_INTERFACE)
        sdk_add_library(${name} INTERFACE)
        set(_scope INTERFACE)
    else()
        sdk_add_library(${name} STATIC ${COMP_SOURCES})
        set(_scope PUBLIC)
        target_include_directories(${name} PRIVATE ${COMP_PRIV_INCLUDE_DIRS})
        target_link_libraries(${name} PRIVATE ${COMP_PRIV_REQUIRES})
    endif()
    target_include_directories(${name} ${_scope} ${COMP_INCLUDE_DIRS})
    target_link_libraries(${name} ${_scope} ${COMP_REQUIRES})
    add_library(sdk::${name} ALIAS ${name})
endfunction()

function(sdk_load_modules)
    set(_kconfig "# Generated external module Kconfig entries\n")
    set(_resolved_modules)
    foreach(_root IN LISTS MODULE_ROOTS)
        file(REAL_PATH "${_root}" _module BASE_DIRECTORY "${TOP_DIR}")
        if(_module IN_LIST _resolved_modules)
            continue()
        endif()
        if(NOT EXISTS "${_module}/sdk-module.cmake")
            message(FATAL_ERROR "Module requires sdk-module.cmake: ${_module}")
        endif()
        unset(SDK_MODULE_KCONFIG)
        include("${_module}/sdk-module.cmake")
        if(DEFINED SDK_MODULE_KCONFIG)
            get_filename_component(_kc "${SDK_MODULE_KCONFIG}" ABSOLUTE BASE_DIR "${_module}")
            if(NOT EXISTS "${_kc}")
                message(FATAL_ERROR "Missing module Kconfig: ${_kc}")
            endif()
            string(APPEND _kconfig "source \"${_kc}\"\n")
        endif()
        set_property(GLOBAL APPEND PROPERTY SDK_MODULE_DIRECTORIES "${_module}")
        list(APPEND _resolved_modules "${_module}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                     "${_module}/sdk-module.cmake")
    endforeach()
    set(MODULE_ROOTS "${_resolved_modules}" PARENT_SCOPE)
    file(WRITE "${KCONFIG_BINARY_DIR}/Kconfig.modules" "${_kconfig}")
endfunction()

function(sdk_build_modules)
    get_property(_modules GLOBAL PROPERTY SDK_MODULE_DIRECTORIES)
    foreach(_module IN LISTS _modules)
        string(SHA256 _key "${_module}")
        if(EXISTS "${_module}/CMakeLists.txt")
            add_subdirectory("${_module}" "${PROJECT_BINARY_DIR}/modules/${_key}")
        endif()
    endforeach()
endfunction()
