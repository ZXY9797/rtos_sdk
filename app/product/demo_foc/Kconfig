menu "FOC Motor Application"
config APP_NAME
    string "Application name"
    default "demo_foc"
config DEMO_FOC_CANOPEN_NODE_ID
    int "Joint CANopen FD node ID"
    range 1 127
    default 1

config DEMO_FOC_JOINT_MOTION
    bool "Enable demo joint motion after board commissioning"
    help
      Allow calibrated motor operation and enable joint brake sequencing.
      Requires verified phase order, dead time, brake operation and joint limits.
endmenu
