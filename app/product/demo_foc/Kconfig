menu "FOC Motor Application"
config APP_NAME
    string "Application name"
    default "demo_foc"
config MOTOR_AUTO_CALIBRATION
    bool "Run input, electrical and output calibration when data are missing"
    default n
config DEMO_FOC_MD007_V1
    bool "MD007 V1 joint feedback and board commissioning"
    depends on CAN_GD32 && GD32F50X_HXTAL_12MHZ && GD32F50X_PLL_192MHZ
    depends on !MOTOR_AUTO_CALIBRATION

config DEMO_FOC_CANOPEN_NODE_ID
    int "Joint CANopen FD node ID"
    depends on DEMO_FOC_MD007_V1
    range 1 127
    default 1

config DEMO_FOC_MD007_MOTION
    bool "Enable MD007 joint motion after board commissioning"
    depends on DEMO_FOC_MD007_V1
    help
      Allow calibrated motor operation and enable k6216 brake sequencing.
      Requires verified phase order, dead time, brake operation and joint limits.
endmenu
