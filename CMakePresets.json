{
  "version": 2,
  "configurePresets": [
    {"name": "demo_foc", "generator": "Ninja", "binaryDir": "${sourceDir}/out/presets/demo_foc", "cacheVariables": {"p": "demo_foc", "t": "armgcc9"}},
    {"name": "demo_foc-release", "inherits": "demo_foc", "binaryDir": "${sourceDir}/out/presets/demo_foc-release", "cacheVariables": {"PROFILE": "release"}},
    {"name": "demo_foc-rtthread", "inherits": "demo_foc", "binaryDir": "${sourceDir}/out/presets/demo_foc-rtthread", "cacheVariables": {"SDK_RTOS_BACKEND": "rt-thread"}},
    {"name": "gimbal", "generator": "Ninja", "binaryDir": "${sourceDir}/out/presets/gimbal", "cacheVariables": {"p": "gimbal", "t": "armgcc9"}},
    {"name": "demo_foc-ble", "generator": "Ninja", "binaryDir": "${sourceDir}/out/presets/demo_foc-ble", "cacheVariables": {"p": "demo_ble", "t": "armgcc9"}}
  ],
  "buildPresets": [
    {"name": "demo_foc", "configurePreset": "demo_foc", "jobs": 8},
    {"name": "demo_foc-release", "configurePreset": "demo_foc-release", "jobs": 8},
    {"name": "demo_foc-rtthread", "configurePreset": "demo_foc-rtthread", "jobs": 8},
    {"name": "gimbal", "configurePreset": "gimbal", "jobs": 8},
    {"name": "demo_foc-ble", "configurePreset": "demo_foc-ble", "jobs": 8}
  ]
}
